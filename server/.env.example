# Server port and database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trustvault
# Address of the website (used in email links). Use http://localhost:5000 after "npm run build".
APP_URL=http://localhost:5173

# Secret keys - filled automatically by "npm run setup". Never share or commit them.
JWT_SECRET=
VAULT_KEY=

# Email (Gmail). Leave SMTP_USER empty for dev mode: emails are saved in server/dev-mail/
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Google Authenticator session length in minutes
SESSION_MINUTES=60
